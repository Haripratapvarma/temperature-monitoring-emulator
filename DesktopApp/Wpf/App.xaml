<Application x:Class="TempLab.DesktopApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D5D8DE" />
        <SolidColorBrush x:Key="AlertBrush" Color="#C62828" />
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="3,2" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A6270" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Counter" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </Application.Resources>
</Application>
